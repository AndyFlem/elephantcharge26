---
pagination:
  data: charges
  size: 1
  alias: charge
permalink: "/charge/{{ charge.charge_ref }}/awards/"
layout: base.njk
---

<section class="charge-header">
  <p class="charge-meta"><a href="/">← All charges</a></p>
  <h1>{{ charge.charge_name }}</h1>
  <p class="charge-meta">{{ charge.charge_date | date }} · {{ charge.location }}</p>

  <nav class="page-tabs">
    <a href="/charge/{{ charge.charge_ref }}/">Results</a>
    <a href="/charge/{{ charge.charge_ref }}/checkpoints/">Checkpoints</a>
    <a href="/charge/{{ charge.charge_ref }}/awards/" class="active">Awards</a>
    {% if charge.grants.length %}
    <a href="/charge/{{ charge.charge_ref }}/grants/">Grants</a>
    {% endif %}
    {% if charge.has_gps_tracks %}
    <a href="/charge/{{ charge.charge_ref }}/map/">🗺 Map</a>
    {% endif %}
  </nav>
</section>

<section>
  {% for aw in charge.award_winners %}
  <div class="award-block">
    <div class="award-block-title">
      <span class="award-ordinal">{{ aw.ordinal }}</span>
      <span class="award-name">{{ aw.name }}</span>
    </div>
    {% if aw.class_name or aw.category %}
    <p class="small muted award-block-scope">
      {% if aw.class_name %}{{ aw.class_name }}{% endif %}
      {% if aw.class_name and aw.category %} · {% endif %}
      {% if aw.category %}{{ aw.category }}{% endif %}
    </p>
    {% endif %}

    {% if aw.results.length %}
    <div style="overflow-x:auto">
    <table>
      <thead>
        <tr>
          <th>#</th>
          <th>Car</th>
          <th>Entry</th>
          <th class="hide-mobile">Class</th>
          <th class="hide-mobile">Categories</th>
          {% if aw.type_ref == 'DISTANCE' %}
          <th class="distance">Distance</th>
          {% else %}
          <th class="distance">Raised</th>
          {% endif %}
          <th>Status</th>
        </tr>
      </thead>
      <tbody>
        {% for r in aw.results %}
        <tr class="{% if loop.first %}award-winner-row{% endif %}">
          <td>{{ loop.index }}</td>
          <td class="car-no">{{ r.car_no }}</td>
          <td>
            {% if loop.first %}🏆 {% endif %}<a href="/entry/{{ r.entry_id }}/">{{ r.entry_name }}</a>
          </td>
          <td class="small hide-mobile">{{ r.class_name or '—' }}</td>
          <td class="small hide-mobile muted">{{ r.categories or '—' }}</td>
          {% if aw.type_ref == 'DISTANCE' %}
          <td class="distance">{{ r.value | km }}</td>
          {% else %}
          <td class="distance">{{ r.value | dollars }}</td>
          {% endif %}
          <td class="small no-wrap">
            {% if r.result_status == 'COMPLETE' %}
            <span class="result-complete">✓ Complete</span>
            {% elif r.result_status %}
            <span class="result-dnf">{{ r.result_status }}</span>
            {% else %}
            <span class="muted">—</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    </div>
    {% else %}
    <p class="small muted">No eligible entries.</p>
    {% endif %}
  </div>
  {% endfor %}
</section>
