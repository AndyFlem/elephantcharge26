---
pagination:
  data: charges
  size: 1
  alias: charge
permalink: "/charge/{{ charge.charge_ref }}/"
layout: base.njk
---

<section class="charge-header">
  <p class="charge-meta"><a href="/">← All charges</a></p>
  <h1>{{ charge.charge_name }}</h1>
  <p class="charge-meta">
    {{ charge.charge_date | date }} · {{ charge.location }}
  </p>

  <nav class="page-tabs">
    <a href="/charge/{{ charge.charge_ref }}/" class="active">Results</a>
    <a href="/charge/{{ charge.charge_ref }}/checkpoints/">Checkpoints</a>
    <a href="/charge/{{ charge.charge_ref }}/awards/">Awards</a>
    {% if charge.grants.length %}
    <a href="/charge/{{ charge.charge_ref }}/grants/">Grants</a>
    {% endif %}
    {% if charge.has_gps_tracks %}
    <a href="/charge/{{ charge.charge_ref }}/map/">🗺 Map</a>
    {% endif %}
  </nav>
</section>

<div class="stats-grid">
  <div class="stat-card">
    <span class="value">{{ charge.entry_count }}</span>
    <span class="label">Entries</span>
  </div>
  <div class="stat-card">
    <span class="value">{{ charge.entry_completed_count }}</span>
    <span class="label">Completed</span>
  </div>
  <div class="stat-card">
    <span class="value">{{ charge.entry_completed_pct | pct }}</span>
    <span class="label">Finish rate</span>
  </div>
  <div class="stat-card">
    <span class="value">{{ charge.raised_dollars | dollars }}</span>
    <span class="label">Raised</span>
  </div>
  <div class="stat-card">
    <span class="value">{{ charge.shortest_distance_m | km }}</span>
    <span class="label">Shortest distance</span>
  </div>
</div>

<section>
  <div style="overflow-x:auto">
  <table>
    <thead>
      <tr>
        <th data-sort="number">#</th>
        <th>Team</th>
        <th data-sort="string">Class</th>
        <th data-sort="number">Result</th>
        <th class="distance" data-sort="number">Net dist.</th>
        <th class="distance" data-sort="number">Competition dist.</th>
        <th class="distance hide-mobile sortable sort-desc" data-sort="number" data-sort-dir="desc">Raised</th>
        <th class="hide-mobile">Categories</th>
      </tr>
    </thead>
    <tbody>
      {% for entry in charge.entries | sortDesc('raised_dollars') %}
      <tr>
        <td class="car-no">{{ entry.car_no }}</td>
        <td>
          <span class="team-dot" style="background:{{ entry.color }}"></span>
          <a href="/entry/{{ entry.entry_id }}/">{{ entry.entry_name }}</a>
        </td>
        <td class="small">{{ entry.class_name }}</td>
        {# Completed entries rank above all others, by competition distance ascending;
           everyone else ranks by checkpoints reached (leg_count) descending. The offset
           below is larger than any realistic competition distance (metres) so the two
           groups never interleave. #}
        <td class="small no-wrap" data-sort-value="{% if entry.result_status == 'COMPLETE' %}{{ entry.distance_total_competition }}{% else %}{{ 10000000 - (entry.leg_count or 0) }}{% endif %}">
          {% if entry.result_status == 'COMPLETE' %}
          <span class="result-complete">✓ Complete</span>
          {% elif entry.result_status %}
          <span class="result-dnf">{{ entry.result_status }}</span>
          {% else %}
          <span class="muted">—</span>
          {% endif %}
        </td>
        <td class="distance" data-sort-value="{{ entry.distance_net }}">
          {% if entry.distance_net != null %}
          {{ entry.distance_net | km }}
          {% else %}—{% endif %}
        </td>
        <td class="distance" data-sort-value="{{ entry.distance_total_competition if entry.result_status == 'COMPLETE' else '' }}">
          {% if entry.distance_total_competition != null %}
          {{ entry.distance_total_competition | km }}
          {% else %}—{% endif %}
        </td>
        <td class="distance hide-mobile" data-sort-value="{{ entry.raised_dollars }}">{{ entry.raised_dollars | dollars }}</td>
        <td class="small hide-mobile muted">{{ entry.categories or '—' }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  </div>

</section>

{% if charge.spirit_name %}
<section>
  <h2>Spirit of the Charge</h2>
  <p><strong>{{ charge.spirit_name }}</strong>{% if charge.spirit_description %} — {{ charge.spirit_description }}{% endif %}</p>
</section>
{% endif %}

{% if charge.shafted_description %}
<section>
  <h2>Most Shafted</h2>
  <p>{{ charge.shafted_description }}</p>
</section>
{% endif %}
